#!/bin/bash

# Pre-commit hook for configdrift
# Ensures code quality before committing

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# 0. Check for Go
if ! command -v go &> /dev/null; then
    echo -e "${RED}Error: 'go' command not found.${NC}"
    echo "Please install Go (1.26.0+) from https://go.dev/dl/"
    exit 1
fi

# 1. Go Mod Tidy
echo -e "Checking go.mod..."
go mod tidy
if [[ -n $(git status --porcelain go.mod go.sum) ]]; then
    echo -e "${RED}Error: go.mod or go.sum are not tidy.${NC}"
    echo "Please run 'go mod tidy' and stage the changes before committing."
    exit 1
fi

# 2. Go Format
echo -e "Checking code formatting..."
unformatted=$(gofmt -l .)
if [[ -n $unformatted ]]; then
    echo -e "${RED}Error: The following files are not formatted:${NC}"
    echo "$unformatted"
    echo -e "${YELLOW}Run 'go fmt ./...' to fix them.${NC}"
    exit 1
fi

# 3. Linting
LINTER="golangci-lint"
if ! command -v $LINTER &> /dev/null; then
    # try to find it in GOPATH/bin
    GOPATH_BIN=$(go env GOPATH)/bin/golangci-lint
    if [[ -f "$GOPATH_BIN" ]]; then
        LINTER="$GOPATH_BIN"
    else
        LINTER=""
    fi
fi

if [[ -n "$LINTER" ]]; then
    echo -e "Running $LINTER..."
    $LINTER run
else
    echo -e "${RED}Error: 'golangci-lint' not found.${NC}"
    echo "This check is mandatory. Please install it by running:"
    echo -e "  ${GREEN}go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.12.1${NC}"
    exit 1
fi

# 4. Testing
echo -e "Running tests..."
go test ./... -short

echo -e "${GREEN}All checks passed! Proceeding with commit.${NC}"
exit 0
