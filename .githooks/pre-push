#!/bin/bash

# Pre-push hook for configdrift
# Ensures all tests pass before pushing to remote

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-push checks (Full Test Suite) via Makefile...${NC}"

# Run full tests
if ! make test; then
    echo -e "${RED}Error: 'make test' failed.${NC}"
    exit 1
fi

echo -e "${GREEN}All tests passed! Proceeding with push.${NC}"
exit 0
