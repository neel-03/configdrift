#!/bin/bash

# Pre-push hook for configdrift
# Ensures all tests pass before pushing to remote

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-push checks (Full Test Suite)...${NC}"

# Check for Go
if ! command -v go &> /dev/null; then
    echo -e "${RED}Error: 'go' command not found.${NC}"
    echo "Please install Go (1.26.0+) from https://go.dev/dl/"
    exit 1
fi

# Run full tests
go test ./...

echo -e "${GREEN}All tests passed! Proceeding with push.${NC}"
exit 0
